# Переменные для `npm run demo`. Скопируйте в .env и заполните.
# Значения из командной строки приоритетнее значений из файла.

# Публичный https-адрес этого сервера демо (туннель на порт PORT).
# Без телефона, только локально, можно не задавать: будет http://localhost:8787.
PUBLIC_URL=https://demo.example.com

# Relay (minter-backend) — тот же, с которым работает кошелёк (его VITE_RELAY_URL).
RELAY_URL=http://localhost:3000

# Direct Link Mini App кошелька из BotFather, обязательно с https://
WALLET_APP_LINK=https://t.me/<Bot>/<short>

# Minter Node API v2 (…/v2). Нужен только для кнопки «Отправить в сеть».
# MINTER_NODE_URL=https://<node>/v2

# PORT=8787
